@app.get("/privacy", response_class=HTMLResponse)
async def privacy_policy():
    html_content = """
    
    
    
        
        
        Privacy Policy - Adam's & Elbaraa Nursery
        
    
    
        Privacy Policy
        Effective Date: August 2026
        This Privacy Policy outlines how Adam's & Elbaraa Nursery handles user data collected through our Facebook Messenger assistant.
        
